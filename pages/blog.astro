---
// Blog landing page: muestra todos los artículos agrupados por categoría
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.SUPABASE_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

let posts = [];

try {
  const { data, error } = await supabase
    .from('blog_posts')
    .select('*')
    .order('fecha_publicacion', { ascending: false });
  if (error) throw error;
  posts = data;
} catch (e) {
  posts = [];
}

const categorias = [...new Set(posts.map(p => p.categoria))];
---

<html lang="es">
  <head>
    <title>Blog SolarPool: Artículos y Guías</title>
    <meta name="description" content="El mejor blog sobre energía solar, climatización de piletas y eficiencia energética en Argentina. Guías, novedades y casos reales." />
  </head>
  <body>
    <h1>Blog SolarPool</h1>
    <p>Noticias, guías y artículos sobre energía solar, climatización y eficiencia energética.</p>
    {categorias.map(cat => (
      <section>
        <h2>{cat}</h2>
        <div class="blog-cards">
          {posts.filter(p => p.categoria === cat).map(post => (
            <a href={`/blog/${post.slug}/`} class="blog-card">
              <img src={post.imagen_destacada_url} alt={post.titulo} />
              <div>
                <h3>{post.titulo}</h3>
                <p>{post.resumen}</p>
                <span>{new Date(post.fecha_publicacion).toLocaleDateString()}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </body>
</html>

<style>
.blog-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
}
.blog-card {
  display: block;
  width: 320px;
  border-radius: 12px;
  box-shadow: 0 2px 8px #0002;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: box-shadow .2s;
}
.blog-card:hover {
  box-shadow: 0 4px 16px #0003;
}
.blog-card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
}
.blog-card h3 {
  margin: 0.5rem 0 0.2rem 0;
}
.blog-card p {
  color: #444;
  font-size: 1rem;
}
</style>
