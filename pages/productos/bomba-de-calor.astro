        <!-- Product Start -->
        <div class="container-fluid faq-section bg-light product-page">

            <div class="row">
                <div class="col-md-6 wow fadeInLeft p-5 col-image-bg" style="background-image: url(/img/bg-pro-bomba-calor-1.jpg);" data-wow-delay="0.2s">

                </div>

                <div class="col-md-6 wow fadeInLeft p-5" data-wow-delay="0.2s">
