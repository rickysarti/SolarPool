                        <a class="btn btn-dark rounded-pill py-3 px-5 mt-4" href="/solicitar-presupuesto/">Solicitar Presupuesto</a>
                        <a class="btn btn-primary rounded-pill py-3 px-5 mt-4" href="/contacto/<?php echo $link_vars; ?>">Formulario de Contacto</a>
                    </div>
