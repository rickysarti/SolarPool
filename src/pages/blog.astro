---
// Blog landing page: muestra todos los artículos agrupados por categoría
import { createClient } from '@supabase/supabase-js';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupabaseLive from '../components/SupabaseLive.astro';

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.SUPABASE_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

let posts = [];
try {
  const { data, error } = await supabase
    .from('blog_posts')
    .select('*')
    .order('fecha_publicacion', { ascending: false });
  if (error) throw error;
  posts = data;
} catch (e) {
  posts = [];
}

const categorias = [...new Set(posts.map((p) => p.categoria))];

// Slugs que tienen página estática en ESTE build. Un post nuevo publicado en
// Supabase después del deploy no tiene /blog/<slug>/ todavía, así que el
// listado en vivo lo enlaza a /blog/post/?slug=... hasta el próximo build.
const slugsPublicados = posts.map((p) => p.slug);
---

<Layout title="Blog SolarPool: Artículos y Guías" description="El mejor blog sobre energía solar, climatización de piletas y eficiencia energética en Argentina.">
  <Header page="blog" />
  <section class="container py-5">
    <div class="text-center mb-4 blog-header">
      <h1 class="display-5">Blog SolarPool</h1>
      <p class="lead">Noticias, guías y artículos sobre energía solar, climatización y eficiencia energética.</p>
    </div>

    <div class="row mb-4 align-items-center">
      <div class="col-md-6 mb-2">
        <input id="search" class="form-control" placeholder="Buscar artículos por título..." />
      </div>
      <div class="col-md-6 text-md-end">
        <div id="category-filters" class="btn-group" role="group" aria-label="Categorías">
          <button class="btn btn-primary btn-sm active" data-cat="all">Todas</button>
          {categorias.map((cat) => (
            <button class="btn btn-outline-primary btn-sm" data-cat={cat}>{cat}</button>
          ))}
        </div>
      </div>
    </div>

    <div id="posts-grid" class="row g-4">
      {posts.map((post) => (
        <div class="col-12 col-md-6 col-lg-4 post-item" data-cat={post.categoria} data-title={post.titulo.toLowerCase()}>
          <a href={`/blog/${post.slug}/`} class="card blog-card h-100 text-decoration-none">
            {post.imagen_destacada_url && (
              <img src={post.imagen_destacada_url} class="card-img-top" alt={post.titulo} />
            )}
              <div class="card-body">
                <h3 class="h5 card-title text-primary">{post.titulo}</h3>
                <p class="card-text text-dark">{post.resumen}</p>
              </div>
            <div class="card-footer bg-transparent border-0 text-muted small">
              {new Date(post.fecha_publicacion).toLocaleDateString()} · {post.autor}
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>
  <!-- Listado en vivo: al abrir la página se vuelve a pedir la lista de posts
       a Supabase, así un artículo nuevo aparece sin recompilar el sitio. -->
  <SupabaseLive />
  <script is:inline define:vars={{ SLUGS_PUBLICADOS: slugsPublicados }}>
    (function () {
      var filters = document.getElementById('category-filters');
      var search = document.getElementById('search');
      var grid = document.getElementById('posts-grid');

      function items() {
        return Array.prototype.slice.call(grid.querySelectorAll('.post-item'));
      }

      function catActiva() {
        var b = filters.querySelector('button.active');
        return b ? b.dataset.cat : 'all';
      }

      function aplicarFiltro(cat, q) {
        items().forEach(function (p) {
          var okCat = cat === 'all' || p.dataset.cat === cat;
          var okQ = !q || (p.dataset.title || '').indexOf(q) !== -1;
          p.style.display = (okCat && okQ) ? '' : 'none';
        });
      }

      function refiltrar() {
        aplicarFiltro(catActiva(), search.value.trim().toLowerCase());
      }

      filters.addEventListener('click', function (e) {
        if (e.target.tagName !== 'BUTTON') return;
        Array.prototype.slice.call(filters.querySelectorAll('button'))
          .forEach(function (b) { b.classList.remove('active'); });
        e.target.classList.add('active');
        refiltrar();
      });

      search.addEventListener('input', refiltrar);

      // ----- Refresco en vivo desde Supabase -----
      var L = window.SolarpoolLive;
      if (!L || !L.ready()) return;

      function urlPost(post) {
        // Si el post ya tiene página estática, va ahí (mejor para SEO).
        // Si es nuevo, lo abre el lector genérico /blog/post/?slug=...
        return SLUGS_PUBLICADOS.indexOf(post.slug) !== -1
          ? '/blog/' + encodeURIComponent(post.slug) + '/'
          : '/blog/post/?slug=' + encodeURIComponent(post.slug);
      }

      function fecha(v) {
        if (!v) return '';
        var d = new Date(v);
        return isNaN(d) ? '' : d.toLocaleDateString();
      }

      function tarjeta(post) {
        var titulo = post.titulo || '';
        var img = L.safeUrl(post.imagen_destacada_url);
        return '<div class="col-12 col-md-6 col-lg-4 post-item" data-cat="' + L.esc(post.categoria || '') +
            '" data-title="' + L.esc(titulo.toLowerCase()) + '">' +
            '<a href="' + L.esc(urlPost(post)) + '" class="card blog-card h-100 text-decoration-none">' +
              (img ? '<img src="' + L.esc(img) + '" class="card-img-top" alt="' + L.esc(titulo) + '">' : '') +
              '<div class="card-body">' +
                '<h3 class="h5 card-title text-primary">' + L.esc(titulo) + '</h3>' +
                '<p class="card-text text-dark">' + L.esc(post.resumen || '') + '</p>' +
              '</div>' +
              '<div class="card-footer bg-transparent border-0 text-muted small">' +
                fecha(post.fecha_publicacion) + ' · ' + L.esc(post.autor || '') +
              '</div>' +
            '</a></div>';
      }

      L.select('blog_posts',
        'select=slug,titulo,resumen,categoria,imagen_destacada_url,fecha_publicacion,autor' +
        '&estado=eq.publicado&order=fecha_publicacion.desc')
        .then(function (posts) {
          if (!posts || !posts.length) return;

          var previa = catActiva();
          var cats = [];
          posts.forEach(function (p) {
            if (p.categoria && cats.indexOf(p.categoria) === -1) cats.push(p.categoria);
          });

          filters.innerHTML =
            '<button class="btn btn-primary btn-sm' + (previa === 'all' ? ' active' : '') + '" data-cat="all">Todas</button>' +
            cats.map(function (c) {
              return '<button class="btn btn-outline-primary btn-sm' + (previa === c ? ' active' : '') +
                '" data-cat="' + L.esc(c) + '">' + L.esc(c) + '</button>';
            }).join('');
          if (!filters.querySelector('button.active')) filters.querySelector('button').classList.add('active');

          grid.innerHTML = posts.map(tarjeta).join('');
          refiltrar();
        })
        .catch(function (e) { console.warn('[solarpool] blog en vivo no disponible:', e); });
    })();
  </script>
  <Footer />
</Layout>

<style>
.blog-header {
  background: linear-gradient(180deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
  padding: 2rem;
  border-radius: 15px;
  margin-bottom: 3rem;
}

.blog-header h1 {
  color: #0b6fb2; /* Azul fuerte de SolarPool */
  margin-bottom: 1rem;
  font-weight: 600;
}

.blog-header p {
  color: #154a7a; /* Azul marino oscuro */
  font-size: 1.25rem;
}

.blog-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0.02));
  border-radius: 10px;
  overflow: hidden;
  transition: transform .18s ease, box-shadow .18s ease;
}
.blog-card:hover { transform: translateY(-6px); box-shadow: 0 8px 30px rgba(0,0,0,0.45); }
.blog-card .card-img-top { height: 180px; object-fit: cover; }
.card-body .card-title { color: #061d18; }
.card-text { color: #556; }

/* Estilos para los botones de categoría */
.btn-outline-primary {
  color: #0b6fb2;
  border-color: #0b6fb2;
  background-color: rgba(255, 255, 255, 0.9);
}

.btn-outline-primary:hover,
.btn-outline-primary:focus {
  color: #fff;
  background-color: #0b6fb2;
  border-color: #0b6fb2;
}

.btn-primary,
.btn-primary.active {
  background-color: #0b6fb2;
  border-color: #0b6fb2;
  color: #fff;
}

.btn-primary:hover,
.btn-primary:focus {
  background-color: #154a7a;
  border-color: #154a7a;
}

#category-filters .btn {
  font-weight: 500;
  text-shadow: none;
  margin: 0 2px;
}
</style>
