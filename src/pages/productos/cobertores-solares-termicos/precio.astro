---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SupabaseLive from "../../../components/SupabaseLive.astro";
import { medidas, formatARS, WHATSAPP, slugMedida, type Espesor } from "../../../lib/cobertores.ts";
import { getPreciosLive, resolverPrecio, urlCompra } from "../../../lib/cobertores-precios";

const MEDIDAS_BASE = "/productos/cobertores-solares-termicos/medidas";

// Precios, stock y links de pago desde Supabase ("solarpool-cobertores").
// Si Supabase no responde, caen los valores históricos de cobertores.ts.
const preciosLive = await getPreciosLive();

const filasDe = (esp: Espesor) =>
  medidas.map((m) => ({
    key: m.key,
    label: m.label,
    slug: slugMedida(m, esp),
    precio: resolverPrecio(preciosLive, m.key, esp, esp === 300 ? m.p300 : m.p400),
  }));

const filas300 = filasDe(300);
const filas400 = filasDe(400);

// medida|espesor -> slug de la subpágina generada en ESTE build. El script en
// vivo sólo enlaza las medidas que ya tienen página; una medida nueva cargada
// en Supabase aparece en la tabla pero sin link hasta el próximo deploy.
const slugsPorClave: Record<string, string> = {};
for (const esp of [300, 400] as Espesor[]) {
  for (const m of medidas) slugsPorClave[`${m.key}|${esp}`] = slugMedida(m, esp);
}
---

<Layout title="Precios Cobertores Solares Térmicos 2026 | Solarpool" description="Lista de precios actualizada de cobertores solares térmicos para piletas. 300 y 400 micrones, todas las medidas. Transferencia o tarjeta. Envío a todo el país.">
  <Header page="cobertores-solares" />

  <!-- Hero -->
  <div class="container-fluid page-banner-productos bg-breadcrumb">
    <div class="container text-center py-5 product-header">
      <div class="col-lg-8 mx-auto wow fadeInUp">
        <h4 class="text-white text-uppercase fw-bold mb-3" style="letter-spacing:3px;font-size:0.9rem;">Cobertores Solares Térmicos</h4>
        <h1 class="display-2 text-white fw-bold mb-4">Lista de Precios</h1>
        <p class="text-white fs-5 mb-5" style="opacity:0.9;">2 espesores disponibles &nbsp;·&nbsp; Transferencia o Tarjeta &nbsp;·&nbsp; Envío a todo el país</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <a class="btn btn-light rounded-pill py-3 px-5 fw-semibold" href="#precios">Ver Precios</a>
          <a class="btn btn-outline-light rounded-pill py-3 px-5 fw-semibold" href="/solicitar-presupuesto/">Solicitar Presupuesto</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Cómo medir -->
  <div class="container-fluid py-5" style="background:#f8f9fa;">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6 wow fadeInLeft" data-wow-delay="0.1s">
          <h2 class="display-5 fw-bold mb-4">¿Cómo medir su pileta?</h2>
          <p class="fs-5 text-muted mb-3">Todos los cobertores se entregan en secciones <strong>cuadradas o rectangulares</strong>, preparados para ajustarse a la medida exacta de su pileta.</p>
          <p class="fs-5 text-muted mb-4">Ingrese el <strong>largo y ancho máximo</strong> de su pileta. Los esquemas muestran las formas más comunes y cómo medirlas correctamente.</p>
          <div class="alert border-0 rounded-3 py-3 px-4" style="background:#e8f4fd;">
            <i class="fas fa-info-circle text-primary me-2"></i>
            <strong>Importante:</strong> Siempre medir los valores máximos aunque la pileta tenga curvas o formas irregulares.
          </div>
        </div>
        <div class="col-lg-6 wow fadeInRight text-center" data-wow-delay="0.2s">
          <img src="/resources/piscinas.jpg" alt="Cómo medir su pileta" class="img-fluid rounded-4 shadow-lg" style="max-width:90%;">
        </div>
      </div>
    </div>
  </div>

  <!-- Selector de espesor + Tabla -->
  <div class="container py-5" id="precios">
    <div class="text-center mb-5 wow fadeInUp">
      <h2 class="display-5 fw-bold mb-3">Lista de Precios</h2>
      <p class="text-muted fs-5 mb-2">Precios en <strong>Pesos Argentinos</strong> &nbsp;·&nbsp; Al pagar con tarjeta el envío se calcula según su localidad</p>
      <p class="text-muted mb-4"><i class="fas fa-hand-pointer me-1"></i> Tocá una medida para ver todos sus detalles.</p>

      <!-- Toggle interactivo -->
      <div class="d-inline-flex rounded-pill p-1 shadow-sm" style="background:#e9ecef;" id="thickness-toggle">
        <button
          class="btn rounded-pill px-5 py-3 fw-bold active-toggle"
          id="btn-300"
          onclick="showTable('300')"
          style="background: linear-gradient(135deg, #0062cc, #004aad); color:white; border:none; font-size:1rem; transition: all 0.3s;">
          <i class="fas fa-layer-group me-2"></i> 300 Micrones
        </button>
        <button
          class="btn rounded-pill px-5 py-3 fw-bold"
          id="btn-400"
          onclick="showTable('400')"
          style="background:transparent; color:#666; border:none; font-size:1rem; transition: all 0.3s;">
          <i class="fas fa-layer-group me-2"></i> 400 Micrones
        </button>
      </div>
    </div>

    <!-- Info del producto seleccionado -->
    <div class="row g-3 mb-4 justify-content-center" id="info-300">
      <div class="col-auto">
        <span class="badge px-3 py-2 rounded-pill" style="background:#e8f0fe;color:#0062cc;font-size:0.9rem;">
          <i class="fas fa-shield-alt me-1"></i> 1 año de garantía
        </span>
      </div>
      <div class="col-auto">
        <span class="badge px-3 py-2 rounded-pill" style="background:#e8f0fe;color:#0062cc;font-size:0.9rem;">
          <i class="fas fa-sun me-1"></i> Protección UV
        </span>
      </div>
    </div>

    <div class="row g-3 mb-4 justify-content-center" id="info-400" style="display:none!important;">
      <div class="col-auto">
        <span class="badge px-3 py-2 rounded-pill" style="background:#ffd700;color:#1a3a00;font-size:0.9rem;font-weight:700;">
          ⭐ RECOMENDADO · Mayor calidad
        </span>
      </div>
      <div class="col-auto">
        <span class="badge px-3 py-2 rounded-pill" style="background:#e8f5ee;color:#1a7a4a;font-size:0.9rem;">
          <i class="fas fa-layer-group me-1"></i> 33% más grueso que el estándar
        </span>
      </div>
      <div class="col-auto">
        <span class="badge px-3 py-2 rounded-pill" style="background:#e8f5ee;color:#1a7a4a;font-size:0.9rem;">
          <i class="fas fa-shield-alt me-1"></i> Mayor vida útil
        </span>
      </div>
      <div class="col-auto">
        <span class="badge px-3 py-2 rounded-pill" style="background:#e8f5ee;color:#1a7a4a;font-size:0.9rem;">
          <i class="fas fa-sun me-1"></i> Protección UV
        </span>
      </div>
    </div>

    <!-- Tabla 300 MIC -->
    <div id="table-300">
      <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead>
              <tr style="background: linear-gradient(135deg, #0062cc 0%, #004aad 100%);">
                <th class="text-white text-center py-4 fw-semibold" style="width:28%;">Tamaño</th>
                <th class="text-white text-center py-4 fw-semibold" style="width:30%;">
                  Precio<br><small class="opacity-75 fw-normal">Transferencia / Depósito</small>
                </th>
                <th class="text-white text-center py-4 fw-semibold" style="width:30%;">
                  Precio<br><small class="opacity-75 fw-normal">Tarjeta Crédito / Débito</small>
                </th>
                <th class="text-white text-center py-4 fw-semibold" style="width:12%;">Online</th>
              </tr>
            </thead>
            <tbody id="tbody-300">
              {filas300.map((f) => (
                <tr data-medida={f.key} data-espesor="300">
                  <td class="text-center fw-bold py-3" style="font-size:1.1rem;">
                    <a href={`${MEDIDAS_BASE}/${f.slug}/`} class="text-decoration-none text-dark d-inline-flex align-items-center">
                      {f.label}<i class="fas fa-angle-right ms-2 text-primary small"></i>
                    </a>
                  </td>
                  {f.precio ? (
                    <>
                      <td class="text-center py-3 fw-semibold fs-5 text-primary">{formatARS(f.precio.transferencia)}</td>
                      <td class="text-center py-3 fw-semibold fs-5 text-primary">{formatARS(f.precio.tarjeta)}</td>
                      <td class="text-center py-3">
                        <a href={urlCompra(f.precio)} class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold" target="_blank" rel="noopener">
                          <i class="fas fa-credit-card me-1"></i> Comprar
                        </a>
                      </td>
                    </>
                  ) : (
                    <td class="text-center py-3 fw-semibold fs-5 text-secondary" colspan="3">
                      <span class="badge bg-secondary rounded-pill px-3 py-2">SIN STOCK</span>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tabla 400 MIC -->
    <div id="table-400" style="display:none;">
      <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead>
              <tr style="background: linear-gradient(135deg, #1a7a4a 0%, #145c38 100%);">
                <th class="text-white text-center py-4 fw-semibold" style="width:28%;">Tamaño</th>
                <th class="text-white text-center py-4 fw-semibold" style="width:30%;">
                  Precio<br><small class="opacity-75 fw-normal">Transferencia / Depósito</small>
                </th>
                <th class="text-white text-center py-4 fw-semibold" style="width:30%;">
                  Precio<br><small class="opacity-75 fw-normal">Tarjeta Crédito / Débito</small>
                </th>
                <th class="text-white text-center py-4 fw-semibold" style="width:12%;">Online</th>
              </tr>
            </thead>
            <tbody id="tbody-400">
              {filas400.map((f) => (
                <tr data-medida={f.key} data-espesor="400">
                  <td class="text-center fw-bold py-3" style="font-size:1.1rem;">
                    <a href={`${MEDIDAS_BASE}/${f.slug}/`} class="text-decoration-none text-dark d-inline-flex align-items-center">
                      {f.label}<i class="fas fa-angle-right ms-2 text-success small"></i>
                    </a>
                  </td>
                  {f.precio ? (
                    <>
                      <td class="text-center py-3 fw-semibold fs-5 text-success">{formatARS(f.precio.transferencia)}</td>
                      <td class="text-center py-3 fw-semibold fs-5 text-success">{formatARS(f.precio.tarjeta)}</td>
                      <td class="text-center py-3">
                        <a href={urlCompra(f.precio)} class="btn btn-success btn-sm rounded-pill px-3 fw-semibold" target="_blank" rel="noopener">
                          <i class="fas fa-credit-card me-1"></i> Comprar
                        </a>
                      </td>
                    </>
                  ) : (
                    <td class="text-center py-3 fw-semibold fs-5 text-secondary" colspan="3">
                      <span class="badge bg-secondary rounded-pill px-3 py-2">SIN STOCK</span>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Nota envío -->
    <div class="alert border-0 rounded-3 mt-4 py-3 px-4" style="background:#fff3cd;">
      <i class="fas fa-truck me-2 text-warning"></i>
      <strong>Envío:</strong> Los precios de transferencia <strong>no incluyen envío</strong>. Al pagar con tarjeta (botón "Comprar"), el envío se calcula automáticamente según tu localidad.
    </div>
  </div>

  <!-- Info Cards -->
  <div class="container-fluid py-5" style="background:#f8f9fa;">
    <div class="container">
      <h3 class="fw-bold mb-4 text-center wow fadeInUp">Información importante</h3>
      <div class="row g-3 justify-content-center">

        <div class="col-md-4 col-lg-3 wow fadeInUp" data-wow-delay="0.1s">
          <div class="d-flex align-items-start p-3 bg-white rounded-3 shadow-sm h-100">
            <div class="text-primary me-3 mt-1 flex-shrink-0"><i class="fas fa-file-invoice fa-lg"></i></div>
            <div>
              <h6 class="fw-bold mb-1">Facturación</h6>
              <p class="mb-0 text-muted small">Factura A o B. Provincia de Misiones: solo Factura B.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4 col-lg-3 wow fadeInUp" data-wow-delay="0.15s">
          <div class="d-flex align-items-start p-3 bg-white rounded-3 shadow-sm h-100">
            <div class="text-primary me-3 mt-1 flex-shrink-0"><i class="fas fa-money-bill-wave fa-lg"></i></div>
            <div>
              <h6 class="fw-bold mb-1">Moneda</h6>
              <p class="mb-0 text-muted small">Precios expresados en <strong>Pesos Argentinos</strong>.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4 col-lg-3 wow fadeInUp" data-wow-delay="0.2s">
          <div class="d-flex align-items-start p-3 bg-white rounded-3 shadow-sm h-100">
            <div class="text-primary me-3 mt-1 flex-shrink-0"><i class="fas fa-box fa-lg"></i></div>
            <div>
              <h6 class="fw-bold mb-1">Entrega</h6>
              <p class="mb-0 text-muted small">Cobertores entregados en cajas de cartón, listos para usar.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4 col-lg-3 wow fadeInUp" data-wow-delay="0.25s">
          <div class="d-flex align-items-start p-3 bg-white rounded-3 shadow-sm h-100">
            <div class="text-primary me-3 mt-1 flex-shrink-0"><i class="fas fa-shield-alt fa-lg"></i></div>
            <div>
              <h6 class="fw-bold mb-1">Garantía</h6>
              <p class="mb-0 text-muted small">1 año contra defectos de fabricación. Ver <a href="/productos/cobertores-solares-termicos/instrucciones-de-uso" class="fw-bold">condiciones</a>.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="container py-5">
    <div class="text-center col-lg-8 mx-auto wow fadeInUp">
      <h2 class="display-5 fw-bold mb-4">¿Necesitás asesoramiento?</h2>
      <p class="fs-5 text-muted mb-5">Contactanos para medidas especiales o preguntas sobre el producto. Atendemos por WhatsApp.</p>
      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="https://api.whatsapp.com/send?phone=5491136171286" class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-semibold" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp me-2"></i> WhatsApp
        </a>
        <a href="/solicitar-presupuesto/" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-semibold">
          <i class="fas fa-calculator me-2"></i> Solicitar Presupuesto
        </a>
        <a href="/contacto/" class="btn btn-outline-secondary btn-lg rounded-pill px-5 py-3 fw-semibold">
          <i class="fas fa-envelope me-2"></i> Contacto
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    gtag('event', 'conversion', {'send_to': 'AW-995509386/9-SDCIaghKEDEIqJ2doD'});

    function showTable(type) {
      var t300 = document.getElementById('table-300');
      var t400 = document.getElementById('table-400');
      var i300 = document.getElementById('info-300');
      var i400 = document.getElementById('info-400');
      var b300 = document.getElementById('btn-300');
      var b400 = document.getElementById('btn-400');

      if (type === '300') {
        t300.style.display = 'block';
        t400.style.display = 'none';
        i300.style.display = 'flex';
        i400.style.display = 'none';
        b300.style.background = 'linear-gradient(135deg, #0062cc, #004aad)';
        b300.style.color = 'white';
        b300.style.boxShadow = '0 4px 15px rgba(0,98,204,0.4)';
        b400.style.background = 'transparent';
        b400.style.color = '#666';
        b400.style.boxShadow = 'none';
      } else {
        t300.style.display = 'none';
        t400.style.display = 'block';
        i300.style.display = 'none';
        i400.style.display = 'flex';
        b400.style.background = 'linear-gradient(135deg, #1a7a4a, #145c38)';
        b400.style.color = 'white';
        b400.style.boxShadow = '0 4px 15px rgba(26,122,74,0.4)';
        b300.style.background = 'transparent';
        b300.style.color = '#666';
        b300.style.boxShadow = 'none';
      }
    }
  </script>

  <!-- Precios en vivo: vuelve a pedirle la tabla a Supabase al cargar la página,
       así los cambios de precio/stock/link se ven sin recompilar el sitio. -->
  <SupabaseLive />
  <script is:inline define:vars={{ BASE: MEDIDAS_BASE, SLUGS: slugsPorClave }}>
    (function () {
      var L = window.SolarpoolLive;
      if (!L || !L.ready()) return;

      function fila(r, esp, tema) {
        var slug = SLUGS[r.medida_key + '|' + esp];
        var label = L.esc(r.label);
        var nombre = slug
          ? '<a href="' + L.esc(BASE + '/' + slug + '/') + '" class="text-decoration-none text-dark d-inline-flex align-items-center">' +
            label + '<i class="fas fa-angle-right ms-2 ' + tema.text + ' small"></i></a>'
          : label;

        var celdas;
        if (r.en_stock && r.precio_transferencia !== null) {
          var url = L.safeUrl(r.link_pago) || L.WHATSAPP;
          var tarjeta = r.precio_tarjeta !== null ? r.precio_tarjeta : r.precio_transferencia;
          celdas =
            '<td class="text-center py-3 fw-semibold fs-5 ' + tema.text + '">' + L.formatARS(r.precio_transferencia) + '</td>' +
            '<td class="text-center py-3 fw-semibold fs-5 ' + tema.text + '">' + L.formatARS(tarjeta) + '</td>' +
            '<td class="text-center py-3"><a href="' + L.esc(url) + '" class="btn ' + tema.btn +
            ' btn-sm rounded-pill px-3 fw-semibold" target="_blank" rel="noopener">' +
            '<i class="fas fa-credit-card me-1"></i> Comprar</a></td>';
        } else {
          celdas = '<td class="text-center py-3 fw-semibold fs-5 text-secondary" colspan="3">' +
            '<span class="badge bg-secondary rounded-pill px-3 py-2">SIN STOCK</span></td>';
        }

        return '<tr data-medida="' + L.esc(r.medida_key) + '" data-espesor="' + esp + '">' +
          '<td class="text-center fw-bold py-3" style="font-size:1.1rem;">' + nombre + '</td>' + celdas + '</tr>';
      }

      L.select('solarpool-cobertores', 'select=*&activo=eq.true&order=orden.asc,espesor.asc')
        .then(function (filas) {
          [300, 400].forEach(function (esp) {
            var tbody = document.getElementById('tbody-' + esp);
            if (!tbody) return;
            var delEspesor = filas.filter(function (r) { return Number(r.espesor) === esp; });
            if (!delEspesor.length) return;
            var tema = esp === 400
              ? { text: 'text-success', btn: 'btn-success' }
              : { text: 'text-primary', btn: 'btn-primary' };
            tbody.innerHTML = delEspesor.map(function (r) { return fila(r, esp, tema); }).join('');
          });
        })
        .catch(function (e) { console.warn('[solarpool] precios en vivo no disponibles:', e); });
    })();
  </script>

  <Footer />
</Layout>
