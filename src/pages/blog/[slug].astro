---
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { blogService } from '../../lib/supabase/blog-service';

export async function getStaticPaths() {
  const slugs = await blogService.getAllPublishedSlugs();
  if (!slugs) return [];
  return slugs.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const article = await blogService.getPostBySlug(slug);

if (!article) {
  throw new Error(`Post not found: ${slug}`);
}

// Convertir Markdown a HTML (simple)
let htmlContent = '';
try {
  htmlContent = await marked.parse(article.contenido || article.resumen || '');
} catch (e) {
  htmlContent = (article.contenido || article.resumen || '').replace(/\n/g, '<br>');
}

// Remover etiquetas <script> como sanitización mínima
htmlContent = String(htmlContent).replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, '');
---
<Layout title={`${article.titulo} | Blog SolarPool`} description={article.subtitulo}>
  <Header page="blog" />
  <article class="blog-post container">
    <header class="py-4">
      <h1 class="display-6">{article.titulo}</h1>
      <h2 class="subtitulo">{article.subtitulo}</h2>
      <meta property="og:title" content={article.titulo} />
      <meta property="og:description" content={article.subtitulo || article.resumen} />
      <meta property="og:image" content={article.imagen_destacada_url} />
      <meta name="author" content={article.autor} />
      <meta name="date" content={article.fecha_publicacion} />
      <meta name="keywords" content={article.categoria} />
      <meta name="robots" content="index, follow" />
      <script type="application/ld+json">
        {JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: article.titulo,
          description: article.subtitulo || article.resumen,
          image: article.imagen_destacada_url,
          author: { '@type': 'Person', name: article.autor },
          datePublished: article.fecha_publicacion,
          articleSection: article.categoria,
          url: `https://www.solarpool.com.ar/blog/${article.slug}`
        })}
      </script>
      <div class="meta text-muted small">
        <span>Por {article.autor}</span> ·
        <span class="mx-2">{new Date(article.fecha_publicacion).toLocaleDateString()}</span> ·
        <span>{article.categoria}</span>
      </div>
      {article.imagen_destacada_url && (
        <img 
          loading="lazy" 
          src={article.imagen_destacada_url}
          alt={article.titulo} 
          class="img-fluid rounded destacada my-3" 
        />
      )}
    </header>

    <section class="contenido" set:html={htmlContent}></section>
  </article>
  <Footer />
</Layout>

<style>
.blog-post {
  max-width: 900px;
  margin: 3rem auto;
  background: #ffffff;
  border-radius: 12px;
  padding: 2rem;
  color: #0b2130;
}
.blog-post .destacada {
  width: 100%;
  border-radius: 6px;
  margin: 1rem 0;
}
.blog-post .meta {
  color: #4a5568;
  font-size: 0.95rem;
  margin-bottom: 0.75rem;
}
.blog-post .subtitulo {
  color: #154a7a; /* azul similar al sitio */
  font-size: 1.25rem;
  margin-top: 0.25rem;
}
.contenido {
  font-size: 1.06rem;
  line-height: 1.8;
  color: #0b2130;
}
.contenido h2, .contenido h3 {
  margin-top: 2rem;
  color: #0b6fb2; /* acento celeste/azul */
}
.contenido table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5rem 0;
}
.contenido th, .contenido td {
  border: 1px solid #ddd;
  padding: 0.5rem 1rem;
}
</style>
