---
interface Props {
  page: string;
}
const logo = "/img/solarpool.png";
const { page } = Astro.props;
const { pathname } = Astro.url;
---

<!-- Spinner Start -->
<div
  id="spinner"
  class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center"
>
  <div
    class="spinner-border text-primary"
    style="width: 3rem; height: 3rem;"
    role="status"
  >
    <span class="sr-only">Cargando...</span>
  </div>
</div>
<!-- Spinner End -->
<!-- Navbar Start -->
<div class="container-fluid nav-bar px-0 px-lg-4 py-lg-0">
  <div class="container">
    <nav class="navbar navbar-expand-lg navbar-light">
      <a href="/" class="navbar-brand p-0">
        <img src={logo} alt="solarpool" />
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarCollapse"
      >
        <span class="fa fa-bars"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav mx-0 mx-lg-auto">
          <a href="/" class={"nav-item nav-link" + (page == "home" && " active")}
            >Home</a
          >

          <a
            href="/ventajas/"
            class={"nav-item nav-link" + (page == "ventajas" && " active")}
            >Ventajas</a
          >
          <a
            href="/obras/"
            class={"nav-item nav-link" + (page == "obras" && " active")}
            >Mapa de Obras</a
          >
          <div class={"nav-item nav-link" + (page == "productos" && " active")}>
            <a href="#" class="nav-link" data-bs-toggle="dropdown">
              <span class="dropdown-toggle">Productos</span>
            </a>
            <div class="dropdown-menu shadow-sm">
              <a
                href="/productos/cobertores-solares-termicos/"
                class="dropdown-item">Cobertores Solares Térmicos</a
              >
              <a
              href="/productos/cobertores-solares-termicos/precio"
              class="dropdown-item">Precios de Cobertores Solares Térmicos</a
              >
              <a href="/productos/calefaccion-solar" class="dropdown-item"
                >Calefacción Solar</a
              >
              <a href="/productos/bomba-de-calor" class="dropdown-item"
                >Bomba de Calor</a
              >
              <a
                href="https://solarpower.com.ar/"
                class="dropdown-item"
                target="_blank">Energía Solar Fotovoltaica</a
              >
            </div>
          </div>
          <!--a
            href="/obras/"
            class={"nav-item nav-link" + (page == "obras" && " active")}>Obras</a
          -->
          <a
            href="/faqs/"
            class={"nav-item nav-link" + (page == "faqs" && " active")}>FAQs</a
          >
          <a
            href={"/contacto/#"+pathname}
            class={"nav-item nav-link" + (page == "contacto" && " active")}
            >Contacto</a
          >
          <a
            href="/blog/"
            class={"nav-item nav-link" + (page == "blog" && " active")}
            >Blog</a
          >
        </div>
      </div>
      <div class="d-none d-xl-flex flex-shrink-0 ps-4 call-phone">
        <div class="d-flex flex-column ms-3 call-phone-number">
          <a
            href="https://api.whatsapp.com/send?phone=5491136171286"
            class="btn btn-dark rounded-pill py-3 px-5"
            ><span>WhatsApp</span> <i class="bi bi-whatsapp"></i>
          </a>
        </div>
      </div>
    </nav>
  </div>
</div>
<!-- Navbar End -->
