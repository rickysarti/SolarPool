                <div class="container">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-12 text-center text-body">
                            Diseño <a class="text-white raghio" href="https://raghio.com"><img src="https://raghio.com/logos/svg/logo-raghio--grey.svg" alt="Logo raghio.com"></a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Copyright End -->
    
    
            <!-- Back to Top -->
            <a href="#" class="btn btn-primary btn-lg-square rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>   
    
            
            <!-- JavaScript Libraries -->
            <script  is:inline src="/lib/jquery.min.js"></script>
            <script  is:inline src="/lib/bootstrap.bundle.min.js"></script>
            <script  is:inline src="/lib/wow/wow.min.js"></script>
            <script  is:inline src="/lib/easing/easing.min.js"></script>
            <script  is:inline src="/lib/waypoints/waypoints.min.js"></script>
            <script  is:inline src="/lib/counterup/counterup.min.js"></script>
            <script  is:inline src="/lib/lightbox/js/lightbox.min.js"></script>
            <script  is:inline src="/lib/owlcarousel/owl.carousel.min.js"></script>
            
    
            <!-- Template Javascript -->
            <script  is:inline src="/js/main.js"></script>