                                                <a href="https://www.instagram.com/solarpool/" target="_blank" class="btn btn-md-square rounded-circle me-3"><i class="bi bi-instagram"></i></a>
                                                <a href="https://x.com/solarpoolarg" target="_blank" class="btn btn-md-square rounded-circle me-3"><i class="bi bi-twitter-x"></i></a>
